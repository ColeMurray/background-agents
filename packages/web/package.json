{
  "name": "@open-inspect/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:mermaid",
    "dev": "next dev",
    "build:mermaid": "node scripts/build-mermaid.mjs",
    "prebuild": "npm run build:mermaid",
    "build": "next build",
    "prebuild:cloudflare": "npm run build:mermaid",
    "build:cloudflare": "npx opennextjs-cloudflare build",
    "deploy:cloudflare": "npx opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:mermaid-browser": "npm run build:mermaid && node scripts/test-mermaid-browser.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@open-inspect/shared": "file:../shared",
    "@pierre/diffs": "1.6.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.17",
    "mermaid": "^12.2.0",
    "next": "^16.4.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.8",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
