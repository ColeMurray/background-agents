{
  "name": "@open-inspect/pi-codemode-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && wrangler deploy --dry-run --outdir dist && node scripts/normalize-build.mjs && node scripts/artifact-manifest.mjs",
    "verify:artifact": "node scripts/artifact-manifest.mjs --verify",
    "test": "node --test ../../scripts/pi-codemode-sandbox-contract.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ scripts/"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.103.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
