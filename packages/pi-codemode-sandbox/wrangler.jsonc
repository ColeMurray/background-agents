{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "open-inspect-pi-codemode-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 60000 },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodemodeSandbox"],
    },
  ],
}
