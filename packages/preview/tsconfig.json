{
  // The launcher runs the control plane's Node host in-process, so it is checked the way that host
  // is (control-plane's tsconfig.node.json): Node types plus the web-standard names Node implements.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // Types the control plane's plain-JS fake Modal peer from its JSDoc.
    "allowJs": true
  },
  "include": ["src/**/*.ts", "vitest.config.ts", "../control-plane/types/node-web.d.ts"]
}
