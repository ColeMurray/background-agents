{
  "name": "@open-inspect/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./session": {
      "import": "./dist/subpaths/session/index.js",
      "types": "./dist/subpaths/session/index.d.ts"
    },
    "./session/events": {
      "import": "./dist/subpaths/session/events.js",
