{
  // Test-only typecheck pass. Co-located *.test.ts files use Node APIs
  // (node:crypto, node:fs, import.meta.url) that the production tsconfig.json
  // deliberately excludes. Production enables `nodejs_compat` for audited
  // dependencies, while Node globals stay off the application type surface so
  // new runtime dependencies remain explicit (see tsconfig.json).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
