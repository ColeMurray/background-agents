{
  // Typecheck pass for test/integration/**. These files execute inside workerd
  // via @cloudflare/vitest-pool-workers, so they compile against workers types
  // plus the `cloudflare:test` module — and, like tsconfig.json, without Node
  // globals: the integration surface should only see what the runner provides.
  // (Node-context files such as vitest.integration.config.ts are not part of
  // this program; they run in the Vite host process.)
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["test/integration/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
