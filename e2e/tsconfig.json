{
  // The browser suite integrates the web app, the preview stack and its launcher from the
  // repository root. Only the preview's dependency-free contract crosses in from a package.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // Types the launcher's plain-Node bundler from its JSDoc.
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
