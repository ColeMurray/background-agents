{
  "name": "open-inspect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sandbox:images": "python3 packages/sandbox-images/cli.py",
    "lint": "eslint .",
    "lint:complexity": "node scripts/lint-complexity.mjs",
    "lint:sql-portability": "node scripts/lint-sql-portability.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:lint-complexity": "node --test scripts/lint-complexity-message.test.mjs",
    "test:lint-sandbox-boundaries": "node --test scripts/lint-sandbox-boundaries.test.mjs",
    "test:lint-sql-portability": "node --test scripts/lint-sql-portability.test.mjs",
    "test:d1-migrate": "node --test scripts/d1-migrate.test.mjs",
    "test:deploy-aws": "node --test scripts/deploy-aws.test.mjs",
    "test:rbac-bootstrap-owner": "node --test scripts/bootstrap-workspace-owner.test.ts",
    "test:user-merge-cli": "node --test scripts/merge-split-users.test.ts",
    "test:cf-logs-cli": "node --test scripts/cf-logs.test.ts",
    "test:terraform-workflow-contract": "node --test scripts/terraform-workflow-contract.test.mjs scripts/terraform-plan-comment.test.mjs",
    "test:node-version-workflow-contract": "node --test scripts/node-version-workflow-contract.test.mjs",
    "test:readme-translations": "node --test scripts/readme-translations.test.mjs",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:coverage-gate": "node --test scripts/check-coverage.test.mjs",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "typecheck": "npm run build -w @open-inspect/shared && npm run typecheck --workspaces --if-present && tsc -p scripts",
    "knip": "knip",
    "build": "npm run build -w @open-inspect/shared && npm run build --workspaces --if-present",
    "rbac:bootstrap-owner": "node scripts/bootstrap-workspace-owner.ts",
    "prepare": "node -e \"if (process.env.CI) process.exit(0)\" && husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "minimatch": "^10.2.5",
    "undici": "^7.29.1",
    "sharp": "^0.35.5",
    "postcss-selector-parser": "^7.1.6",
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,yaml,yml,css}": [
      "prettier --write"
    ],
    "packages/{boat-infra,daytona-infra,e2b-infra,modal-infra,sandbox-runtime,sandbox-images}/**/*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  }
}
