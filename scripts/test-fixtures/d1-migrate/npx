#!/usr/bin/env bash
set -euo pipefail

if [ "${1:-}" != "wrangler" ]; then
  echo "Expected the d1 migration runner to invoke wrangler" >&2
  exit 2
fi
shift

printf '%s\n' "$*" >> "${D1_MIGRATE_TEST_LOG:?}"
TEST_VERSION="${D1_MIGRATE_TEST_VERSION:-0047}"
TEST_FILENAME="${D1_MIGRATE_TEST_FILENAME:-0047_terminal_browser_auth.sql}"

case "$*" in
  *"CREATE TABLE IF NOT EXISTS _schema_migrations"*)
    ;;
  *"SELECT version, name FROM _schema_migrations"*)
    if [ "${D1_MIGRATE_TEST_APPLIED:-false}" = "true" ]; then
      printf '[{"results":[{"version":"%s","name":"%s"}]}]\n' \
        "$TEST_VERSION" \
        "${D1_MIGRATE_TEST_RECORDED_NAME:-$TEST_FILENAME}"
    else
      printf '[{"results":[]}]\n'
    fi
    ;;
  *"_status.sql"*)
    printf '[{"results":[{"status":"%s"}]}]\n' "${D1_MIGRATE_TEST_STATUS:?}"
    ;;
  *"_preflight.sql"*)
    printf '[{"results":[{"status":"%s","invalid_email_count":1,"duplicate_email_user_count":2,"invalid_user_ids":"blank-user","duplicate_user_ids":"duplicate-a,duplicate-b"}]}]\n' \
      "${D1_MIGRATE_TEST_PREFLIGHT_STATUS:-ready}"
    ;;
  *"INSERT INTO _schema_migrations"*)
    ;;
  *"SELECT name FROM _schema_migrations"*)
    printf '[{"results":[{"name":"%s"}]}]\n' \
      "${D1_MIGRATE_TEST_RECORDED_NAME:-$TEST_FILENAME}"
    ;;
  *"--file "*"${TEST_FILENAME}"*)
    if [ "$D1_MIGRATE_TEST_STATUS" = "complete" ]; then
      echo "Complete schema must repair the ledger without replaying DDL" >&2
      exit 99
    fi
    ;;
  *)
    echo "Unexpected wrangler invocation: $*" >&2
    exit 3
    ;;
esac
